Options -Indexes
# Override the project-root deny only for the public web directory.
Require all granted
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
DirectoryIndex index.php
<IfModule mod_mime.c>
    AddType text/javascript .mjs
    AddType application/wasm .wasm
</IfModule>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
