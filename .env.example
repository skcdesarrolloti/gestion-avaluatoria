APP_ENV=local
# Dejar vacío cuando el dominio apunta a public/. Usar /public si el hosting
# todavía expone el proyecto como dominio.com/public.
APP_BASE_PATH=
SESSION_SECURE=false
SESSION_IDLE_SECONDS=28800
AUTO_MIGRATE=true
# Solo para diagnosticar hosting temporalmente; no muestra secretos.
APP_DIAGNOSTICS=false
# Carpetas de PDFs dentro de storage/. Dejar estos valores o vacio usa la misma ruta interna.
NTS_STORAGE_DIR=storage/normas-tecnicas-sectoriales
LEGAL_STORAGE_DIR=storage/marco-juridico-nacional

# Base EXCLUSIVA del nuevo proyecto. Nunca indicar aqui la base de WordPress.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_avaluatoria
DB_USERNAME=
DB_PASSWORD=

# Conexion de SOLO LECTURA a funcionarios de SuCasa.
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_DATABASE=
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
AUTH_TABLE=wp_jet_cct_funcionarios
AUTH_USER_COLUMN=user_others_apss
AUTH_PASSWORD_COLUMN=pass_others_apss
# Activar solo si el sistema existente almacena las claves en texto plano.
AUTH_ALLOW_LEGACY_PASSWORDS=false
# Opcional: lista separada por comas de roles exactos; vacio = funcionarios activos.
AUTH_ALLOWED_ROLES=
